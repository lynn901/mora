# Mora 平台——环境变量模板
# 复制为 .env 并按需修改：cp .env.example .env
# 敏感值（JWT_SECRET / POSTGRES_PASSWORD / INTERNAL_SERVICE_TOKEN）必须更换！

# ── 宿主端口 ─────────────────────────────────────────
MORA_API_PORT=8990
MCP_SERVER_PORT=8081
MORA_FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_PASSWORD=change-me-pg-password

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_TTL=8h

# ── 内部服务鉴权 ─────────────────────────────────────
INTERNAL_SERVICE_TOKEN=change-me-internal-token
MORA_API_URL=http://localhost:8080

# ── Embedding ────────────────────────────────────────
# 可选: tei（默认）| ollama
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── PostgreSQL 全文搜索 ──────────────────────────────
# 安装了 zhparser 的中文 PG 镜像: chinese_zh
# 标准 postgres:16 无 zhparser 时: simple
FTS_CONFIG=simple

# ── 速率限制 ─────────────────────────────────────────
RATE_LIMIT_DOC_PER_MIN=300
RATE_LIMIT_SEARCH_PER_MIN=200
MCP_RATE_LIMIT_READ=100
MCP_RATE_LIMIT_WRITE=20

# ── 可观测（可选 Prometheus profile） ────────────────
# 启用: docker compose --profile monitoring up -d
# MONITORING_PASS=admin

# ── 备份 ──────────────────────────────────────────────
# 启用定时备份: docker compose --profile backup up -d
# BACKUP_RETENTION_DAYS=30

# ── 后端 Worker ───────────────────────────────────────
COLLAB_MAX_CONCURRENT=50

# ── 多格式文档解析（design-docs/10） ───────────────────
# 对象存储（上传原文件 + 解析产物）
# 必须带 scheme：http://host:port（objstore 以此为 URL 前缀构造 SigV4 请求）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mora
# 生产/HTTPS 置 true；本地开发 false
MINIO_SECURE=false
MINIO_REGION=us-east-1

# 解析 sidecar（P2 多模态/版式 PDF）；空=禁用，纯 Go 库覆盖 P0/P1
# 启用：docker compose --profile parser up -d，然后置
#   MORA_PARSER_URL=http://mora-parser:8000
#   WHISPER_URL=http://mora-parser:8001   # 若 sidecar 内置 whisper.cpp ASR
MORA_PARSER_URL=
# ASR（whisper.cpp HTTP server）；空=禁用
WHISPER_URL=
# sidecar 部署变量
MORA_PARSER_PORT=8000          # 宿主暴露端口（调试用；默认仅同网可达）
MORA_PARSER_TOKEN=             # 共享密钥（rag-worker X-Sidecar-Token）；空=无鉴权
OLLAMA_URL=http://ollama:11434  # VLM 复用 Ollama（须 --profile ollama 同起）
# 单文件上传上限（MB）
PARSE_MAX_FILE_MB=100
# OCR 默认语言
PARSE_OCR_DEFAULT_LANG=chi_sim+eng
# Ollama VLM 模型 id（图像描述，P2）
PARSE_VLM_MODEL=minicpm-v
# 解析任务重试次数
PARSE_TASK_MAX_ATTEMPT=3
PARSE_DEAD_LETTER_STREAM=doc_events:parse_dead

# ── CodeGraph sidecar（可选 profile: codegraph，design-docs/17 §9）──
# 只读代码符号 / 调用 / 影响查询能力（ADR-0001，commit c6aaa20 锁定）。
# 启用：docker compose --profile codegraph up -d
# sidecar 不暴露宿主端口（仅 compose 内网，mora-api/knowledge-worker 经 daemon socket 调用）；
# 不持 Git/Mora 凭据，只收 mora-api 签发的短效服务 token（与 INTERNAL_SERVICE_TOKEN 分离）。
# 默认不出网，100% 本地构建与查询。
CODEGRAPH_SERVICE_TOKEN=change-me-codegraph-token

# ── knowledge-worker 出网与 SSRF 防护（design-docs/14 §6）─────────
# knowledge-worker 消费 source_events / knowledge_events Streams（§5）。
# 出网为硬约束：URL/API/Git 来源必须经 egress 校验。
# 默认 EGRESS_ALLOW_DOMAINS 为空=不出网；架构红线：默认不出网配置不可改。
# 需要拉取外部来源时显式设为逗号分隔的主机列表（精确或 *.suffix），例：
#   EGRESS_ALLOW_DOMAINS=raw.githubusercontent.com,api.github.com
EGRESS_ALLOW_DOMAINS=
# 是否允许私网（10/172.16/192.168/169.254 等）；默认 false。
# 仅 internal trust_level 来源 + 显式开启时才放行（§6.2）。
EGRESS_ALLOW_PRIVATE_RANGES=false
# 每次重定向重新校验，最大跳转次数（默认 5）
EGRESS_MAX_REDIRECTS=5
# 单次响应大小上限（字节，默认 100MB），流式读超额即断
EGRESS_MAX_RESPONSE_BYTES=104857600
# 单次出网请求超时（默认 30s）
EGRESS_TIMEOUT=30s
