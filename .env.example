# Wiki 平台——环境变量模板
# 复制为 .env 并按需修改：cp .env.example .env
# 敏感值（JWT_SECRET / POSTGRES_PASSWORD / INTERNAL_SERVICE_TOKEN）必须更换！

# ── 宿主端口 ─────────────────────────────────────────
WIKI_API_PORT=8990
MCP_SERVER_PORT=8081
WIKI_FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# ── PostgreSQL ───────────────────────────────────────
POSTGRES_PASSWORD=change-me-pg-password

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_TTL=8h

# ── 内部服务鉴权 ─────────────────────────────────────
INTERNAL_SERVICE_TOKEN=change-me-internal-token

# ── Embedding ────────────────────────────────────────
# 可选: tei（默认）| ollama
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── PostgreSQL 全文搜索 ──────────────────────────────
# 安装了 zhparser 的中文 PG 镜像: chinese_zh
# 标准 postgres:16 无 zhparser 时: simple
FTS_CONFIG=simple

# ── 速率限制 ─────────────────────────────────────────
RATE_LIMIT_DOC_PER_MIN=300
RATE_LIMIT_SEARCH_PER_MIN=200
MCP_RATE_LIMIT_READ=100
MCP_RATE_LIMIT_WRITE=20

# ── 可观测（可选 Prometheus profile） ────────────────
# 启用: docker compose --profile monitoring up -d
# MONITORING_PASS=admin

# ── 备份 ──────────────────────────────────────────────
# 启用定时备份: docker compose --profile backup up -d
# BACKUP_RETENTION_DAYS=30

# ── 后端 Worker ───────────────────────────────────────
COLLAB_MAX_CONCURRENT=50
