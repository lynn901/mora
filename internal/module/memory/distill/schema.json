{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mora/phase4/memory_candidate.schema.json",
  "title": "MemoryCandidate",
  "description": "ExtractionProvider output contract (design-docs/18 §5.2). A candidate that fails validation is dropped and the Evidence retained for retry — never write a half-structured Memory (fail closed).",
  "type": "array",
  "minItems": 0,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["memory_type", "statement", "validity", "confidence", "evidence_locator"],
    "properties": {
      "memory_type": {
        "type": "string",
        "enum": ["fact", "decision", "constraint", "preference", "event"]
      },
      "statement": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "scope": {
        "type": "string",
        "maxLength": 1024
      },
      "validity": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valid_from": { "type": ["string", "null"], "format": "date-time" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "entity_keys": {
        "type": "object",
        "additionalProperties": true
      },
      "evidence_locator": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id"],
        "properties": {
          "evidence_id": { "type": "string", "format": "uuid" },
          "quote_locator": { "type": "object" }
        }
      }
    }
  }
}
